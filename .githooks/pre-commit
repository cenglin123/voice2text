#!/bin/bash
# Pre-commit hook — Python stack (voice2text).
# 安装：git config core.hooksPath .githooks（本文件即 .githooks/pre-commit）
# 职责：① 记忆目录结构兜底（fail-closed）② 治理文档变更提醒（WARN）③ Python 语法兜底
set -e

echo "=== Pre-commit: Python ==="

STAGED=()
while IFS= read -r file; do
    [ -n "$file" ] && STAGED+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

# 优先项目自带解释器，保证与运行时一致；Windows 上 Git Bash 也能用正斜杠路径。
PY=python
if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x "runtime/python/python.exe" ]; then
    PY="runtime/python/python.exe"
fi

if [ ${#STAGED[@]} -gt 0 ]; then
    # 只在项目显式配置了 lint 时才跑风格检查；否则退回语法编译，
    # 避免 PATH 上偶然存在的 flake8/ruff 用默认规则（如 79 列）误伤提交。
    LINTER=""
    if [ -f ruff.toml ] || [ -f .ruff.toml ] || { [ -f pyproject.toml ] && grep -q '\[tool\.ruff' pyproject.toml 2>/dev/null; }; then
        command -v ruff >/dev/null 2>&1 && LINTER="ruff" || true
    elif [ -f .flake8 ] || { [ -f setup.cfg ] && grep -q '\[flake8\]' setup.cfg 2>/dev/null; }; then
        command -v flake8 >/dev/null 2>&1 && LINTER="flake8" || true
    fi
    case "$LINTER" in
        ruff)
            ruff check "${STAGED[@]}"
            ruff format --check "${STAGED[@]}"
            ;;
        flake8)
            flake8 "${STAGED[@]}"
            ;;
        *)
            if command -v "$PY" >/dev/null 2>&1; then
                "$PY" - "${STAGED[@]}" <<'PY' || exit 1
import subprocess
import sys

bad = 0
for path in sys.argv[1:]:
    # 检查将要提交的暂存 blob，而不是工作区内容。
    blob = subprocess.run(["git", "show", f":{path}"], capture_output=True)
    data = blob.stdout if blob.returncode == 0 else open(path, "rb").read()
    try:
        compile(data, path, "exec")
    except SyntaxError as exc:
        print(f"[pre-commit] FAIL — {path}: {exc}")
        bad = 1
raise SystemExit(bad)
PY
            else
                echo "[pre-commit] WARN — 无可用 Python，跳过语法检查" >&2
            fi
            ;;
    esac
fi

check_memory_structure() {
    # 记忆体系存在性以工作区或索引为准——避免 `git rm --cached` 或删目录绕过 fail-closed。
    if [ ! -d ".agents/memory" ] && [ -z "$(git ls-files .agents/memory 2>/dev/null)" ]; then
        return 0
    fi

    if git diff --cached --name-only --diff-filter=D | grep -qx ".agents/memory/MEMORY.md"; then
        echo "[pre-commit] FAIL — 暂存区删除了 .agents/memory/MEMORY.md" >&2
        return 1
    fi

    if [ ! -f ".agents/memory/MEMORY.md" ]; then
        echo "[pre-commit] FAIL — .agents/memory/ exists but MEMORY.md is missing" >&2
        return 1
    fi

    if [ ! -s ".agents/memory/MEMORY.md" ]; then
        echo "[pre-commit] FAIL — .agents/memory/MEMORY.md is empty" >&2
        return 1
    fi

    if git cat-file -e :.agents/memory/MEMORY.md 2>/dev/null \
        && [ "$(git cat-file -s :.agents/memory/MEMORY.md)" -eq 0 ]; then
        echo "[pre-commit] FAIL — 暂存区里的 .agents/memory/MEMORY.md 为空" >&2
        return 1
    fi

    if ! grep -q ".agents/memory/MEMORY.md" AGENTS.md 2>/dev/null; then
        echo "[pre-commit] WARN — AGENTS.md missing pointer to .agents/memory/MEMORY.md" >&2
    fi

    return 0
}

check_governance_changes() {
    # 识别暂存区里的治理文档变更，只提醒不拦截（WARN）。
    STAGED_FILES=$(git diff --cached --name-only)
    GOV_PATTERNS="^AGENTS\.md$|^docs/STRUCTURE\.md$|^docs/audit-checklist\.md$|^docs/problems/bugfix/_template\.md$|^scripts/(audit|check_all|maintain|changelog)\.py$|^\.githooks/|^\.gitattributes$"

    GOV_FILES=""
    while IFS= read -r path; do
        if echo "$path" | grep -qE "$GOV_PATTERNS"; then
            GOV_FILES="$GOV_FILES  - $path"$'\n'
        fi
    done <<< "$STAGED_FILES"

    if [ -n "$GOV_FILES" ]; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "📋 检测到治理文档变更"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "以下治理文档（入口规则 / 审计与维护脚本 / 钩子等）已变更："
        echo "$GOV_FILES"
        echo ""
        echo "按 AGENTS.md「硬约束 → 治理文档改动必须独立复查」执行分级复查（准则段改动 ≥3 独立 reviewer，其余治理改动 ≥1），不要依赖执行者自检。"
        echo ""
        echo "本次提交不会因此被拒绝。"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
    fi
    return 0
}

if ! check_memory_structure; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ".agents/memory/ 目录结构不完整。"
    echo ""
    echo "这可能是因为："
    echo "  1. .agents/memory/ 目录存在但 MEMORY.md 缺失或为空"
    echo "  2. 记忆文件被误删"
    echo ""
    echo "修复：重新创建 .agents/memory/MEMORY.md 或从模板恢复。"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 1
fi

check_governance_changes

echo "=== OK ==="
